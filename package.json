{
  "name": "luckyx-studio",
  "version": "0.1.15",
  "description": "luckyx. Studio — 本地视频工作流启动器",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "tsx scripts/preview.ts",
    "check": "vue-tsc --noEmit",
    "build": "electron-vite build",
    "test": "node scripts/test.mjs",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis",
    "validate:installer": "node scripts/validate-installer.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "assets:brand": "node scripts/prepare-brand.mjs",
    "assets:covers": "node scripts/prepare-model-covers.mjs",
    "assets:installer": "node scripts/prepare-installer-brand.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@phosphor-icons/vue": "2.2.1",
    "sql.js": "1.14.2",
    "vue": "3.5.44",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/sql.js": "1.4.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "5.2.4",
    "7zip-bin": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "electron-winstaller": "5.4.0",
    "sharp": "0.35.5",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vue-tsc": "3.3.13"
  },
  "build": {
    "appId": "studio.luckyx.desktop",
    "productName": "luckyx. Studio",
    "afterPack": "scripts/windows-resources.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "bootstrap/7za.exe"
      },
      {
        "from": "node_modules/7zip-bin/LICENSE.txt",
        "to": "bootstrap/7zip-bin-LICENSE.txt"
      },
      {
        "from": "build/7zip-LICENSE.txt",
        "to": "bootstrap/7zip-LICENSE.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": "nsis",
      "executableName": "luckyx. Studio",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "luckyx-Studio-Setup-${version}-${arch}.${ext}",
      "shortcutName": "luckyx. Studio",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "displayLanguageSelector": false
    }
  }
}
